<odoo>
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <tree class="header_custom" multi_edit="1" create="1" edit="1" delete="1" decoration-danger="(is_late)">
                <header>
                    <button name="property_xlsx_report" type="object" string=" Print xlsx" class="btn-primary"/>
                </header>
                <field name="owner_id" />
                <field name="name"/>
                <field name="is_late" invisible="1"/>
                <field name="postcode"/>
                <field name="date_availability"/>
                <field name="selling_price"/>
                <field name="garden"/>
                <field name="state"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="property_view_form" model="ir.ui.view">
        <field name="name">Property Form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" class="oe-button_box">
                        <button name="action_open_related_owner"
                                type="object"
                                icon="fa-user"
                                string="Owner"
                                invisible="not owner_id"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg-color="text-bg-danger" invisible="active"/>
                    <header>
                        <button name="action" type="object" class="btn-primary" string="Action" />
                        <button name="action_draft" type="object" class="btn-primary" string="Set To Draft" invisible="state in ('draft','closed')"/>
                        <button name="action_pending" type="object" class="btn-success" string="Set To Pending" invisible="state!='draft'"/>
                        <button name="action_sold" type="object" class="btn-info" string="Set To Sold" invisible="state!='pending'"/>
                        <field name="state" widget="statusbar" />
                    </header>
                    <div class="oe_title">
                        <label for="ref"/>
                        <h1>
                             <field name="ref"/>
                        </h1>

                        <label for="name"/>
                        <h1>
                             <field name="name" readonly="state=='closed'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General Info.">
                            <field name="postcode" readonly="state=='closed'"/>
                            <field name="date_availability" required="1" readonly="state=='closed'"/>
                            <field name="expected_selling_date" readonly="state=='closed'"/>
                            <field name="is_late" readonly="state=='closed'"/>
                            <field name="expected_price" readonly="state=='closed'"/>
                            <field name="selling_price" readonly="state=='closed'"/>
                            <field name="diff" readonly="state=='closed'"/>
                            <field name="bedrooms" readonly="state=='closed'"/>
                            <field name="living_area" readonly="state=='closed'"/>
                            <field name="facades" readonly="state=='closed'"/>
                            <field name="active" readonly="state=='closed'"/>
                        </group>
                         <group string="Additional Info.">
                            <field name="owner_id" readonly="state=='closed'"/>
                            <field name="owner_address" readonly="state=='closed'"/>
                            <field name="owner_phone" readonly="state=='closed'"/>
                            <field name="garage" readonly="state=='closed'"/>
                            <field name="garden" readonly="state=='closed'"/>
                            <field name="garden_area" readonly="state=='closed'"/>
                            <field name="garden_orientation" readonly="state=='closed'"/>
                            <field name="tag_ids" widget="many2many_tags" readonly="state=='closed'"/>
                        </group>
                        <group>
                            <field name="description" required="1"/>
                        </group>
                        <notebook>
                            <page string="Bedrooms">
                                <field name="line_ids" readonly="state=='closed'">
                                    <tree editable="bottom">
                                        <field name="area"/>
                                        <field name="description"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

      <record id="property_view_search" model="ir.ui.view">
        <field name="name">property search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="postcode"/>
                <field name="name"/>

                <filter name="is_garden" string="With Garden" domain="[('garden','=','True')]"/>
                <filter name="group_garden" string="Garden" context="{'group_by':'garden'}"/>

            </search>
        </field>
    </record>



    <record id="property_closed_server_action" model="ir.actions.server">
        <field name="name">Close Property</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field><!--code means python code-->
        <field name="code">
            action = records.action_closed()
        </field>
    </record>

    <record id="change_state_wizard_server_action" model="ir.actions.server">
        <field name="name">Change State</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field> <!--code means python code-->
        <field name="code">
            action = records.action_change_state_wizerd()
        </field>
    </record>

    <record id="check_selling_date_corn" model="ir.cron">
        <field name="name">Property: Check Selling Date</field>
        <field name="model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            action = model.check_expected_selling_date()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field> <!-- -1 means call it every day forever-->
    </record>

    <record id="property_action" model="ir.actions.act_window">
        <field name="name">property action</field>
        <field name="res_model">property</field>
    </record>
    <!-- Start OWL -->
    <record id="list_view_action" model="ir.actions.client">
        <field name="name">properties List View</field>
        <field name="tag">app_one.action_list_view</field> <!-- coming from js file-->
    </record>
    <menuitem
        id ="properity_list_view_menu_item"
        name = "properties OWL"
        parent="properties_menu"
        action="list_view_action"
    />
    <!-- End OWL -->
    <menuitem
        id ="properity_ment_item"
        name = "properties"
        parent="properties_menu"
        action="property_action"
    />
</odoo>